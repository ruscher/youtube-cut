# Pacote local a partir deste repositório:
#   cd packaging/arch && makepkg -si
# Desinstalar: sudo pacman -R youtube-cut

pkgname=youtube-cut
pkgver=0.1.0
pkgrel=1
pkgdesc="Encontra quando um termo é dito nos vídeos do YouTube e corta esses trechos"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'yt-dlp' 'ffmpeg')
optdepends=('nodejs: runtime JS exigido pelo YouTube (ou deno)'
            'deno: alternativa ao nodejs'
            'yt-dlp-ejs: solucionador de desafios sem baixar do GitHub'
            'libva-mesa-driver: corte local acelerado por GPU AMD (VA-API)'
            'intel-media-driver: corte local acelerado por GPU Intel (VA-API)'
            'python-opencv: reconhecimento facial (detector YuNet e reconhecedor SFace)'
            'whisper-cpp: legenda por IA quando o vídeo não tiver legenda')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')

# o código-fonte é o próprio repositório, dois níveis acima
_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  /usr/bin/python -m build --wheel --no-isolation --outdir "$srcdir/dist"
  rm -rf build src/*.egg-info
}

package() {
  /usr/bin/python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 "$_root/data/youtube-cut.desktop" "$pkgdir/usr/share/applications/youtube-cut.desktop"
  install -Dm644 "$_root/data/youtube-cut.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/youtube-cut.svg"
  install -Dm644 "$_root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
